# Copie este arquivo para ".env" na raiz do projeto (mesmo nivel do
# docker-compose.yml) e preencha com seus dados reais.
# Esse ".env" tambem NUNCA deve ser commitado.

MYSQL_ROOT_PASSWORD=sua_senha_aqui

# Senha do usuario "flight_reader", que so' tem SELECT nas 5 tabelas Gold.
# E' com ele que a API conecta no Docker; o root fica so' para o init e o
# healthcheck do container.
MYSQL_READONLY_PASSWORD=outra_senha_aqui
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
