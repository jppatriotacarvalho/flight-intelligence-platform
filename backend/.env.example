# Copie este arquivo para ".env" e preencha com seus dados reais.
# O arquivo ".env" NUNCA deve ser commitado (ja esta no .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_NAME=flight_intelligence

# Opcional — usuario somente leitura, como no Docker. Crie-o no seu MySQL
# (o SQL esta' no README, Opcao 2) e troque as duas linhas acima por:
# DB_USER=flight_reader
# DB_PASSWORD=a_senha_que_voce_escolheu

# Agente de IA (Etapa 20)
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.8-flash
